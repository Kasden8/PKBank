<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PKBank.App.Views.MainWindow"
        Width="1152" Height="720" MinWidth="960" MinHeight="600"
        Title="PKBank"
        Icon="avares://PKBank/Assets/icon.png"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Border x:Name="Header" Grid.Row="0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="HeaderLeft" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Image x:Name="HeaderIcon" Width="26" Height="26" Source="avares://PKBank/Assets/icon.png" />
                    <TextBlock x:Name="HeaderTitle" VerticalAlignment="Center" Text="PKBank" />
                    <TextBlock x:Name="HeaderTag" VerticalAlignment="Center" Text="Every Pokémon, one place." />
                </StackPanel>
                <TextBlock x:Name="HeaderRight" Grid.Column="1" VerticalAlignment="Center" Text="v0.1.0" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Rail" Grid.Column="0" />
            <ContentControl x:Name="Host" Grid.Column="1" />
        </Grid>

        <Border x:Name="Footer" Grid.Row="2">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="FooterHints" Orientation="Horizontal" VerticalAlignment="Center" Spacing="18" />
                <TextBlock x:Name="FooterCredit" Grid.Column="1" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Text="PKBank · free &amp; open source (GPL-3.0)" />
            </Grid>
        </Border>
    </Grid>
</Window>
